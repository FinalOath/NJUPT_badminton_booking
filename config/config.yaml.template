# ============================
# 南邮羽毛球预约 - 配置模板
# 复制为 config.yaml 并填入自己的学号
# 用 setup.bat / setup.py 可自动生成
# ============================

auth:
  # 你的学号（南邮统一身份认证账号）
  student_id: ""
  password: ""
  cas_mode: "wecom"

api:
  base_url: "https://wechat.njupt.edu.cn/mini_program/v4"
  timeout_seconds: 30

token_capture:
  # 自动抓包刷新 token
  enabled: true
  timeout_seconds: 300
  fallback_timeout_seconds: 60
  mitm_port: 8080
  mode: pc_wechat            # pc_wechat | phone
  refresh_time: "11:30"

booking:
  # 要抢的场次（按优先级从高到低）
  targets:
    - court_name: "仙林体育馆主馆1F羽毛球1号场地"
      time: "16:00-17:00"
    - court_name: "仙林体育馆主馆1F羽毛球2号场地"
      time: "16:00-17:00"
    - court_name: "仙林体育馆3F羽毛球馆1号场地"
      time: "16:00-17:00"
    - court_name: "仙林体育馆3F羽毛球馆2号场地"
      time: "16:00-17:00"
    - court_name: "仙林体育馆3F羽毛球馆1号场地"
      time: "17:00-18:00"
    - court_name: "仙林体育馆3F羽毛球馆2号场地"
      time: "17:00-18:00"
  book_ahead_days: 7
  schedule_time: "12:00"

notify:
  enable_desktop: true
  enable_console: true
